<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تسجيل الدخول | فيرست إير كوند</title>
<link rel="icon" href="/images/logo-firstaircond.jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="login-wrap">
    <div class="login-card">
      <div class="brand-mark">
        <img src="/images/logo-firstaircond.jpeg" alt="First Air Cond logo">
      </div>
      <h1>تسجيل الدخول</h1>
      <p class="sub">إدارة المنتجات والرسائل لـ firstaircond.com</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login" autocomplete="off">
        <div class="field">
          <label for="username">اسم المستخدم</label>
          <input type="text" id="username" name="username" required autofocus>
        </div>
        <div class="field">
          <label for="password">كلمة المرور</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-navy btn-block">تسجيل الدخول</button>
      </form>
    </div>
  </div>
</body>
</html>
