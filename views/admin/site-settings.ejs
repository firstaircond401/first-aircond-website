<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>محتوى الموقع | الإدارة</title>
<link rel="icon" href="/images/logo-firstaircond.jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<div class="admin-topbar">
  <div class="container">
    <a href="/admin/products" class="brand-mark"><img src="/images/logo-firstaircond.jpeg" alt="">الإدارة</a>
    <div class="admin-tabs">
      <a href="/admin/products">المنتجات</a>
      <a href="/admin/categories">الأقسام</a>
      <a href="/admin/site-settings" class="active">محتوى الموقع</a>
      <a href="/admin/social-settings">التواصل الاجتماعي</a>
      <a href="/admin/qr-code">QR Code</a>
      <a href="/admin/messages">الرسائل</a>
    </div>
    <div class="admin-user"><span>مسجل كـ <strong style="color:#fff;"><%= username %></strong></span><form method="POST" action="/admin/logout"><button type="submit" class="link-btn">تسجيل الخروج</button></form></div>
  </div>
</div>

<main class="admin-main">
  <div class="admin-head"><div><h1>محتوى الصفحة الرئيسية</h1><p class="sub">عدّل النصوص التي تظهر للعملاء. تُنشر التغييرات مباشرة بعد الحفظ.</p></div><a href="/" target="_blank" class="btn btn-ghost">معاينة الموقع</a></div>
  <% if (saved) { %><div class="alert alert-ok">تم حفظ محتوى الموقع بنجاح.</div><% } %>
  <form method="POST" action="/admin/site-settings" class="settings-form">
    <section class="settings-card">
      <h2>القسم الرئيسي</h2>
      <div class="form-grid">
        <div class="field full"><label>السطر العلوي</label><input name="heroEyebrow" value="<%= settings.heroEyebrow %>"></div>
        <div class="field full"><label>العنوان الرئيسي</label><input name="heroTitle" value="<%= settings.heroTitle %>" required></div>
        <div class="field full"><label>الوصف</label><textarea name="heroDescription"><%= settings.heroDescription %></textarea></div>
        <div class="field"><label>زر المنتجات</label><input name="heroPrimaryLabel" value="<%= settings.heroPrimaryLabel %>"></div>
        <div class="field"><label>زر الزيارة</label><input name="heroSecondaryLabel" value="<%= settings.heroSecondaryLabel %>"></div>
      </div>
    </section>

    <section class="settings-card">
      <h2>معلومات الخدمة</h2>
      <div class="form-grid">
        <% for (let i = 1; i <= 4; i++) { %>
          <div class="field"><label>العنوان <%= i %></label><input name="gauge<%= i %>Label" value="<%= settings['gauge' + i + 'Label'] %>"></div>
          <div class="field"><label>القيمة <%= i %></label><input name="gauge<%= i %>Value" value="<%= settings['gauge' + i + 'Value'] %>"></div>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <h2>نقاط الثقة</h2>
      <div class="form-grid">
        <% for (let i = 1; i <= 4; i++) { %>
          <div class="field"><label>عنوان النقطة <%= i %></label><input name="trust<%= i %>Title" value="<%= settings['trust' + i + 'Title'] %>"></div>
          <div class="field"><label>وصف النقطة <%= i %></label><input name="trust<%= i %>Text" value="<%= settings['trust' + i + 'Text'] %>"></div>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <h2>الخدمات</h2>
      <div class="form-grid">
        <div class="field"><label>العنوان الصغير</label><input name="servicesEyebrow" value="<%= settings.servicesEyebrow %>"></div>
        <div class="field"><label>عنوان القسم</label><input name="servicesTitle" value="<%= settings.servicesTitle %>"></div>
        <% for (let i = 1; i <= 4; i++) { %>
          <div class="field"><label>اسم الخدمة <%= i %></label><input name="service<%= i %>Title" value="<%= settings['service' + i + 'Title'] %>"></div>
          <div class="field"><label>وصف الخدمة <%= i %></label><textarea name="service<%= i %>Text"><%= settings['service' + i + 'Text'] %></textarea></div>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <h2>العلامات والكتالوج</h2>
      <div class="form-grid">
        <div class="field full"><label>عنوان العلامات التجارية</label><input name="brandsTitle" value="<%= settings.brandsTitle %>"></div>
        <div class="field"><label>عنوان الكتالوج الصغير</label><input name="catalogEyebrow" value="<%= settings.catalogEyebrow %>"></div>
        <div class="field"><label>عنوان الكتالوج</label><input name="catalogTitle" value="<%= settings.catalogTitle %>"></div>
        <div class="field"><label>زر عرض المنتجات</label><input name="catalogButton" value="<%= settings.catalogButton %>"></div>
      </div>
    </section>

    <section class="settings-card">
      <h2>الدعوة للتواصل</h2>
      <div class="form-grid">
        <div class="field full"><label>العنوان</label><input name="ctaTitle" value="<%= settings.ctaTitle %>"></div>
        <div class="field full"><label>الوصف</label><textarea name="ctaText"><%= settings.ctaText %></textarea></div>
        <div class="field"><label>نص الزر</label><input name="ctaButton" value="<%= settings.ctaButton %>"></div>
      </div>
    </section>
    <section class="settings-card" dir="ltr">
      <h2>English homepage content</h2>
      <p class="help-text">These values appear when visitors choose English.</p>
      <% const englishFields = [
        ['heroEyebrowEn','Hero eyebrow'],['heroTitleEn','Hero title'],['heroDescriptionEn','Hero description'],
        ['heroPrimaryLabelEn','Products button'],['heroSecondaryLabelEn','Site visit button'],
        ['gauge1LabelEn','Detail 1 label'],['gauge1ValueEn','Detail 1 value'],['gauge2LabelEn','Detail 2 label'],['gauge2ValueEn','Detail 2 value'],
        ['gauge3LabelEn','Detail 3 label'],['gauge3ValueEn','Detail 3 value'],['gauge4LabelEn','Detail 4 label'],['gauge4ValueEn','Detail 4 value'],
        ['trust1TitleEn','Trust 1 title'],['trust1TextEn','Trust 1 text'],['trust2TitleEn','Trust 2 title'],['trust2TextEn','Trust 2 text'],
        ['trust3TitleEn','Trust 3 title'],['trust3TextEn','Trust 3 text'],['trust4TitleEn','Trust 4 title'],['trust4TextEn','Trust 4 text'],
        ['brandsTitleEn','Brands heading'],['servicesEyebrowEn','Services eyebrow'],['servicesTitleEn','Services heading'],
        ['service1TitleEn','Service 1 title'],['service1TextEn','Service 1 description'],['service2TitleEn','Service 2 title'],['service2TextEn','Service 2 description'],
        ['service3TitleEn','Service 3 title'],['service3TextEn','Service 3 description'],['service4TitleEn','Service 4 title'],['service4TextEn','Service 4 description'],
        ['catalogEyebrowEn','Catalog eyebrow'],['catalogTitleEn','Catalog heading'],['catalogButtonEn','Catalog button'],
        ['ctaTitleEn','Final CTA title'],['ctaTextEn','Final CTA description'],['ctaButtonEn','Final CTA button']
      ]; %>
      <div class="form-grid">
        <% englishFields.forEach(([key, label]) => { %>
          <div class="field <%= key.includes('Description') || key.endsWith('TextEn') ? 'full' : '' %>">
            <label><%= label %></label>
            <% if (key.includes('Description') || key.endsWith('TextEn')) { %><textarea name="<%= key %>"><%= settings[key] %></textarea><% } else { %><input name="<%= key %>" value="<%= settings[key] %>"><% } %>
          </div>
        <% }); %>
      </div>
    </section>
    <div class="sticky-save"><button type="submit" class="btn btn-primary">حفظ ونشر التغييرات</button></div>
  </form>
</main>
</body>
</html>
