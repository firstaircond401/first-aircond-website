<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>المنتجات | الإدارة | فيرست إير كوند</title>
<link rel="icon" href="/images/logo-firstaircond.jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-topbar">
  <div class="container">
    <a href="/admin/products" class="brand-mark">
      <img src="/images/logo-firstaircond.jpeg" alt="First Air Cond logo">
      الإدارة
    </a>
    <div class="admin-tabs">
      <a href="/admin/products" class="active">المنتجات</a>
      <a href="/admin/messages">الرسائل <% if (unreadCount > 0) { %><span class="badge"><%= unreadCount %></span><% } %></a>
    </div>
    <div class="admin-user">
      <span>مسجل كـ <strong style="color:#fff;"><%= username %></strong></span>
      <form method="POST" action="/admin/logout"><button type="submit" class="link-btn">تسجيل الخروج</button></form>
    </div>
  </div>
</div>

<main class="admin-main">
  <div class="admin-head">
    <div>
      <h1>المنتجات</h1>
      <p class="sub">هذه الأسعار والصور والوصفات هي ما يراه العملاء على الموقع العام.</p>
    </div>
    <a href="/admin/products/new" class="btn btn-primary">+ إضافة منتج</a>
  </div>

  <% if (saved) { %>
    <div class="alert alert-ok">تم حفظ المنتج.</div>
  <% } %>

  <% if (products.length === 0) { %>
    <div class="table-card" style="padding: 60px 20px; text-align:center;">
      <h3>لا توجد منتجات</h3>
      <p>أضف أول منتج لك لتظهر على الموقع العام.</p>
      <a href="/admin/products/new" class="btn btn-primary">+ إضافة منتج</a>
    </div>
  <% } else { %>
    <div class="table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th>الصورة</th>
            <th>الاسم</th>
            <th>العلامة</th>
            <th>التصنيف</th>
            <th>السعر</th>
            <th>التوفر</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((p) => { %>
            <tr>
              <td>
                <% if (p.image) { %>
                  <img class="row-thumb" src="<%= p.image %>" alt="">
                <% } else { %>
                  <div class="row-thumb-empty">لا توجد صورة</div>
                <% } %>
              </td>
              <td><%= p.name %></td>
              <td><%= p.brand || '—' %></td>
              <td><%= p.category %></td>
              <td><%= Number(p.price).toLocaleString('ar-EG') %> ج.م</td>
              <td><span class="stock-badge <%= p.in_stock ? 'in' : 'out' %>"><%= p.in_stock ? 'متوفر' : 'غير متوفر' %></span></td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-ghost btn-sm" href="/admin/products/<%= p.id %>/edit">تعديل</a>
                  <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('حذف هذا المنتج؟ لا يمكن التراجع.');">
                    <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

</body>
</html>
