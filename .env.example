# Copy this file to .env and fill it in (or just run: npm run setup)

# MongoDB Atlas connection string. Required for local and Vercel deployments.
MONGODB_URI=
MONGODB_DB=first-aircond

# Port the server listens on
PORT=3000

# Filled in automatically by "npm run setup" - do not hand-write the hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies.
# "npm run setup" generates one for you automatically.
SESSION_SECRET=

# Set to "production" when deploying for real (enables secure cookies)
NODE_ENV=development
